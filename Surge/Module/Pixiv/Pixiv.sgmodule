#!name = Pixiv去广告
#!desc = 去除Pixiv应用内广告
#!icon = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/04ProxySoft/pixiv(1).png
#!system = ios
#!tag = 去广告

[Rule]
DOMAIN-SUFFIX,ads-pixiv.net,REJECT
DOMAIN,pixiv.org,REJECT

[MITM]
hostname = %APPEND% oauth.secure.pixiv.net

[Script]
Pixiv Premium = type=http-response, pattern=^https://oauth\.secure\.pixiv\.net/auth/token, requires-body=true, script-path=https://raw.githubusercontent.com/tyleroh/Tools/main/Surge/Module/Pixiv/pixiv_premium.js, tag=Pixiv去广告