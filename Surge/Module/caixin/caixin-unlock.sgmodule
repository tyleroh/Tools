#!name=财新文章解锁
#!desc=解锁文章正文与收听功能

[Script]
文章正文 = type=http-response,pattern=^https://mappsv5\.caixin\.com/articlev5/\d+/\d+\.html,script-path=https://raw.githubusercontent.com/tyleroh/Tools/main/Surge/Module/caixin/caixin-article.js,script-update-interval=300,requires-body=true,max-size=524288,timeout=30
mini文章正文 = type=http-response,pattern=^https://mini\.caixin\.com/(m/)?\d{4}-\d{2}-\d{2}/\d+\.html,script-path=https://raw.githubusercontent.com/tyleroh/Tools/main/Surge/Module/caixin/caixin-article.js,script-update-interval=300,requires-body=true,max-size=524288,timeout=30
文章权限 = type=http-response,pattern=^https://gateway\.caixin\.com/api/app-api/auth/newValidate$,script-path=https://raw.githubusercontent.com/tyleroh/Tools/main/Surge/Module/caixin/caixin-vip.js,requires-body=true,max-size=131072
音频解锁 = type=http-response,pattern=^https://gateway\.caixin\.com/api/app-api/auth/validateAudioAuth$,script-path=https://raw.githubusercontent.com/tyleroh/Tools/main/Surge/Module/caixin/caixin-audio.js,requires-body=true,max-size=131072,timeout=25
deepview配置 = type=http-response,pattern=^https://deepview-dynamic\.caixin\.com/api/topic/config/(event|topic)/,script-path=https://raw.githubusercontent.com/tyleroh/Tools/main/Surge/Module/caixin/caixin-deepview.js,requires-body=true,max-size=131072,timeout=10

[Rule]
DOMAIN,gg.caixin.com,REJECT
DOMAIN,dolphin.caixin.com,REJECT

[Map Local]
# 财新去广告，来源 https://t.me/Aa28413761/2067
^https:\/\/cxdata\.caixin\.com\/api\/dataplus\/stkData\/list data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/entities\.caixin\.com\/api\/public\/push\/appIndex\?(?:[^#?&]+&)*target=index data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/gateway\.caixin\.com\/api\/app-api\/search\/getkeyword data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/gateway\.caixin\.com\/api\/app-api\/caixinminiapp\/appinfo data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/gateway\.caixin\.com\/api\/app-api\/articlesHotRecommend\/getHotRecommendArticles data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/www\.caixin\.com\/ai\/question.+ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% mappsv5.caixin.com, gateway.caixin.com, mini.caixin.com, cxdata.caixin.com, entities.caixin.com, www.caixin.com, deepview-dynamic.caixin.com
