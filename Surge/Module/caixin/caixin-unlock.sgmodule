#!name=财新文章解锁
#!desc=只解锁文章

[Script]
文章正文 = type=http-response,pattern=^https://mappsv5\.caixin\.com/articlev5/\d+/\d+\.html,script-path=https://raw.githubusercontent.com/tyleroh/Tools/main/Surge/Module/caixin/caixin-article.js,script-update-interval=300,requires-body=true,max-size=524288,timeout=30
文章权限 = type=http-response,pattern=^https://gateway\.caixin\.com/api/app-api/auth/newValidate$,script-path=https://raw.githubusercontent.com/tyleroh/Tools/main/Surge/Module/caixin/caixin-vip.js,requires-body=true,max-size=131072

[Rule]
DOMAIN-SUFFIX,gg.caixin.com,REJECT

[MITM]
hostname = %APPEND% mappsv5.caixin.com, gateway.caixin.com
