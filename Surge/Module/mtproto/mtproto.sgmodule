#!name=MTProto_Proxy
#!desc=MTProto代理模块，支持Telegram加速。ipv6 参数可编辑（true启用IPv6，false禁用）
#!author=tyler
#!category=工具
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/Telegram_05.png
#!arguments=IPv6:true
#!arguments-desc=ipv6 开关：true 启用 IPv6，false 禁用 IPv6

[MTProto]
interface = 127.0.0.1
port = 5753
secret = 0123456789abcdef0123456789abcdef
ipv6 = {{{IPv6}}}