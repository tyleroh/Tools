#!name=扫描全能王签到
#!desc=获取扫描全能王Cookie并进行定时签到
#!author=MaYIHEI
#!icon=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/camscanner.png
#!arguments=cron:15 10 * * *
#!arguments-desc=📌 参数说明\n\ncron: 签到定时任务的 cron 表达式\n默认每天上午 10:15 执行（15 10 * * *）

[Script]
# 获取 Cookie
扫描全能王 Cookie = type=http-request,pattern=^https:\/\/api-cs\.intsig\.net\/user\/cs\/get_user_attribute,requires-body=false,max-size=0,script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/camscanner/camscanner.cookie.js

# 定时签到任务
扫描全能王签到 = type=cron,cronexp="{{{cron}}}",timeout=120,script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/camscanner/camscanner.js

[MITM]
hostname = %APPEND% api-cs.intsig.net
